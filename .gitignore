# ==========================================
# STOCKFLOW - INVENTORY MANAGEMENT SYSTEM
# Laravel Project - Git Ignore Configuration
# ==========================================

# Environment Files
.env
.env.*
!.env.example

# PHP / Laravel
*.log
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
/auth.json
/vendor/
/bootstrap/cache/*.php

# Node.js / Frontend Dependencies
/node_modules/
/public/build/
/public/hot

# Laravel Storage
/public/storage
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore

# Uploaded Files
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/public/uploads/

# Database Backups and Exports
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.sqlite-*

# IDE / Editor Settings
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Operating System Files
.DS_Store
Thumbs.db

# Local Development / Homestead
Homestead.json
Homestead.yaml